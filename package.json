{
  "name": "tacket",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first raw AI thread transfer for coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/cli",
    "apps/native-host",
    "packages/thread-format"
  ],
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:checksums": "node scripts/generate-checksums.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "validate:sample": "sample_path=$(node apps/cli/bin/tacket.js sample --out /tmp/tacket-sample-validate) && node scripts/validate-bundle.mjs \"$sample_path\"",
    "package:release": "bash scripts/package-release.sh",
    "test": "node --test packages/thread-format/test/*.test.js apps/chrome-extension/test/*.test.js apps/cli/test/*.test.js apps/native-host/test/*.test.js",
    "test:swift-host": "swift build --package-path apps/mac/TacketApp && node scripts/smoke-swift-host.mjs apps/mac/TacketApp/.build/debug/TacketNativeHost",
    "lint": "node scripts/check-project.mjs",
    "verify": "npm run lint && npm run check:versions && npm test && npm run validate:sample && npm run test:swift-host",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1"
  }
}
