{
  "manifest_version": 3,
  "name": "Tacket Dev",
  "version": "0.1.0",
  "description": "Development build of Tacket with local file demo access.",
  "action": {
    "default_title": "Tacket",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/tacket-16.png",
      "32": "icons/tacket-32.png",
      "48": "icons/tacket-48.png",
      "128": "icons/tacket-128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/tacket-16.png",
    "32": "icons/tacket-32.png",
    "48": "icons/tacket-48.png",
    "128": "icons/tacket-128.png"
  }
}
